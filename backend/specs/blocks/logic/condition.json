    "out": [
      { "name": "next", "type": "LogicGate", "description": "Flow out if condition holds true" }
    ]
  },
  "props": {
    "expression": { "type": "string", "default": "amount > 0", "description": "Logical expression to assert", "required": true },
    "errorMessage": { "type": "string", "default": "INVALID_AMOUNT", "description": "Error code name on abort", "required": true }
  },
  "concepts": ["entry-function"],
  "permissionEffects": [],
  "auditHints": ["assert-check", "sc008-check"]
}
