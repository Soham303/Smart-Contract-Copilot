  "title": "Voting / Proposal",
  "description": "On-chain decentralized proposal voting with configurable voting periods and quorum thresholds.",
  "ports": {
    "in": [],
    "out": [
      { "name": "gov_out", "type": "GovernanceRef", "description": "Governance reference" }
