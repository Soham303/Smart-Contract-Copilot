{
  "type": "logic.condition",
  "category": "Logic",
  "title": "Condition (require)",
  "description": "Enforces an assert/require condition check with a custom Move error abort code.",
  "ports": {
    "in": [
      { "name": "trigger", "type": "LogicGate", "description": "Trigger flow in" }
