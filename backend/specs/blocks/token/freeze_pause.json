  "concepts": ["capability", "object", "signer"],
  "permissionEffects": [
    { "action": "Pause transfers", "actor": "Owner/Admin" },
    { "action": "Unpause transfers", "actor": "Owner/Admin" }
  ],
  "auditHints": ["emergency-stop", "sc012-check"]
}
